# INACTIVE TEMPLATE: only install under .github/workflows/ after authorized workflow-write access.
# Measured parallel CI pilot. Never attach to RIFT or use a self-hosted runner.
# Existing comprehensive PR regression remains authoritative during comparison.
name: Cloud validation pilot
on:
  push:
    branches:
      - 'research/**'
      - 'cloud/**'
    paths:
      - 'rift_taxi/**'
      - 'tests/**'
      - 'scripts/cloud_test_runner.py'
      - '.github/workflows/cloud-fast.yml'
      - 'pyproject.toml'
  workflow_dispatch:
permissions:
  contents: read
concurrency:
  group: cloud-pilot-${{ github.ref }}
  cancel-in-progress: true
jobs:
  shards:
    name: Linux shard ${{ matrix.index }}
    runs-on: ubuntu-latest
    timeout-minutes: 10
    strategy:
      fail-fast: false
      max-parallel: 4
      matrix:
        index: [0, 1, 2, 3]
    steps:
      - uses: actions/checkout@v4
        with:
          persist-credentials: false
      - uses: actions/setup-python@v5
        with:
          python-version: '3.14'
      - name: Run assigned complete test modules
        run: python -B -m scripts.cloud_test_runner run --shards 4 --index ${{ matrix.index }} --out cloud-results/shard-${{ matrix.index }}.json
      - name: Retain shard receipt
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: cloud-shard-${{ matrix.index }}
          path: cloud-results/shard-${{ matrix.index }}.json
          if-no-files-found: error
          retention-days: 14
  merge:
    name: Verify exact test coverage
    needs: shards
    if: ${{ !cancelled() }}
    runs-on: ubuntu-latest
    timeout-minutes: 5
    steps:
      - uses: actions/checkout@v4
        with:
          persist-credentials: false
      - uses: actions/setup-python@v5
        with:
          python-version: '3.14'
      - uses: actions/download-artifact@v4
        with:
          pattern: cloud-shard-*
          path: cloud-results
          merge-multiple: true
      - name: Recompute inventory and verify all receipts
        run: python -B -m scripts.cloud_test_runner merge --shards 4 --dir cloud-results --out cloud-results/merged.json
      - name: Retain verified aggregate
        uses: actions/upload-artifact@v4
        with:
          name: cloud-test-aggregate
          path: cloud-results/merged.json
          if-no-files-found: error
          retention-days: 14
